{
  "name": "pandoras-gate",
  "version": "0.3.0",
  "description": "Pandora's Gate — Writer's Studio: a desktop app for writing novels with local and remote AI assistance",
  "main": "out/main/index.js",
  "author": "Davin Taddeo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "package:dir": "electron-vite build && electron-builder --config electron-builder.yml --dir"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@43.3.0": true,
    "node-llama-cpp@3.19.1": true
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tiptap/core": "^3.30.1",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "diff": "^9.0.0",
    "immer": "^11.1.16",
    "isomorphic-git": "^1.41.3",
    "markdown-it": "^15.0.0",
    "node-llama-cpp": "^3.19.1",
    "prosemirror-changeset": "^2.4.1",
    "prosemirror-markdown": "^1.13.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
